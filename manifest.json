{
  "manifest_version": 3,
  "name": "znuny-styler",
  "author": "Renato Mestre",
  "version": "1.0.2",
  "description": "Make Znuny easier to use.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*/znuny/*"
  ],
  "action": {
    "default_title": "znuny-styler enabled",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}