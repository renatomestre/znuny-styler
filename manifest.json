{
  "manifest_version": 3,
  "name": "znuny-styler",
  "author": "Renato Mestre",
  "version": "1.0.3",
  "description": "Make Znuny easier to use.",
  "browser_specific_settings": {
    "gecko": {
      "id": "znuny-styler@renatomestre",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*/znuny/*"
  ],
  "action": {
    "default_title": "znuny-styler enabled",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}