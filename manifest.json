{
  "manifest_version": 3,
  "name": "znuny-styler",
  "author": "Renato Mestre",
  "version": "1.0.0",
  "description": "Turn ZNuny padding more easy.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://callcenterotrs.trf3.jus.br/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "znuny-styler enabled",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
